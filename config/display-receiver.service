[Unit]
Description=Hallenvisualisierung Display-Client Command Receiver
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/hallenvisualisierung/client
ExecStart=/home/pi/hallenvisualisierung/venv/bin/python command_receiver.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
